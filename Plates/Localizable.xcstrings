        }
      }
    },
    "Edit.Ask.Label": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What should change?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこを変更しますか？"
          }
        }
      }
    },
