    "Edit.Ask.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what you want to change. Review the proposed edits before they are applied."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更したい内容を入力してください。変更を適用する前に、変更案を確認できます。"
          }
        }
      }
    },
    "Edit.Ask.Label": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What should change?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこを変更しますか？"
          }
        }
      }
    },
