    "Generate.Description.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a dish, pick what is in your kitchen, or do both. When you pick ingredients, the recipe is written from those alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料理名を入力するか、キッチンにある材料を選択してください。両方でもかまいません。材料を選択した場合は、その材料だけでレシピを生成します。"
          }
        }
      }
    },
