    "Generate.Description.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a dish, pick what is in your kitchen, or do both. When you pick ingredients, the recipe is written from those alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料理名を書くか、キッチンにあるものを選んでください。両方でもかまいません。材料を選ぶと、そのなかだけでレシピを作ります。"
          }
        }
      }
    },
    "Generate.Description.Label": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to cook?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を作りますか？"
          }
        }
      }
    },
    "Generate.Description.Prompt": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
