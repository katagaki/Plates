      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The generation model writes recipes and makes the changes you ask for. The verification model sorts each recipe into its lists and checks changed recipes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成モデルはレシピを書き、頼まれた変更をします。検証モデルはレシピを各項目に整理し、変更したレシピを確認します。"
