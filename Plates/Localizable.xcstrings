      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What you ask for and the recipes you write or change are sent to %1$@ with your key. Your key is kept in the Keychain on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頼んだ内容と、書いたり変更したりするレシピは、あなたのキーで%1$@に送信されます。キーはこのiPhoneのキーチェーンに保存されます。"
          }
        }
      }
