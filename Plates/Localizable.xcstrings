    "Generate.Prompt.Ask.Any": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out a one-pan recipe I can cook tonight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜作れるワンパンのレシピを考えてください。"
          }
        }
      }
    },
    "Generate.Prompt.Ask.Dish": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out a one-pan version of %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をワンパンで作るレシピを考えてください。"
          }
        }
      }
    },
    "Generate.Prompt.Base": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The dish and its ingredients are already chosen. Give the recipe its title and its timing, sort the ingredients you were given into fresh, pantry, and optional, and give each one an amount. Write every name exactly as it was given to you, add nothing that is not on the list, and drop an ingredient only when the dish truly does not need it. Prep work such as \"finely diced\" belongs in the method, not in an amount, so leave it out here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料理と材料はすでに決まっています。レシピに題名と所要時間を付け、渡された材料を生鮮、常備品、任意に分け、それぞれに分量を書いてください。名前は渡されたとおりに書き、一覧にないものは足さず、その料理にどうしても要らないときだけ材料を落とします。「みじん切り」のような下ごしらえは作り方に書くので、分量には入れません。"
          }
        }
      }
    },
    "Generate.Prompt.Base.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the title, the timing, the measured shopping list, and the tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "題名、所要時間、分量を付けた材料の一覧、道具を書いてください。"
          }
        }
      }
    },
    "Generate.Prompt.Base.Tools": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The cook has listed the tools they own, so the recipe can only use those. Do not ask for a tool they did not list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作る人は持っている道具を挙げているので、レシピはその範囲で書きます。挙げられていない道具は使わないでください。"
          }
        }
      }
    },
    "Generate.Prompt.Have.Ingredients": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "All I have to cook with: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元にある材料は%1$@だけです。"
          }
        }
      }
    },
    "Generate.Prompt.Have.Tools": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "All I have to cook in: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使える道具は%1$@だけです。"
          }
        }
      }
    },
    "Generate.Prompt.HouseStyle": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You write recipes for a one-pan cooking site. Every recipe is cooked in a single frying pan on a home stove, uses ingredients from an ordinary supermarket, and finishes in under half an hour.\n\nWrite plainly, like a good cookbook. Never use em-dashes. Do not use breathless adjectives, and do not pad with rule-of-three lists. Write ranges with the word \"to\", never a dash.\n\nWrite everything in English."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはワンパン料理のサイトのレシピを書きます。どのレシピも家庭のコンロでフライパン一つで作れて、普通のスーパーで買える材料を使い、30分以内に仕上がります。\n\n良い料理書のように、飾らずに書いてください。大げさな形容は使わず、三つ並べで水増しもしません。範囲は記号ではなく「から」で書きます。\n\nすべて日本語で書いてください。"
          }
        }
      }
    },
    "Generate.Prompt.Line.Dish": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Dish: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料理: %1$@。"
          }
        }
      }
    },
    "Generate.Prompt.Line.Ingredients": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingredients: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料: %1$@。"
          }
        }
      }
    },
    "Generate.Prompt.Line.Method": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Method: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作り方: %1$@。"
          }
        }
      }
    },
    "Generate.Prompt.Line.Summary": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe: %1$@, %2$@, serves %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピ: %1$@、%2$@、%3$@人分。"
          }
        }
      }
    },
    "Generate.Prompt.Line.Tools": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道具: %1$@。"
          }
        }
      }
    },
    "Generate.Prompt.Outline": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are outlining the method only. Give each step a short imperative title such as \"Brown pork\" or \"Toast first side\". Do not explain the steps, the titles alone are enough, and do not number them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで書くのは作り方の流れだけです。各手順に「豚肉を焼く」「片面を焼く」のような短い題名を付けてください。中身は書かず、題名だけで十分です。番号も振りません。"
          }
        }
      }
    },
    "Generate.Prompt.Outline.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Outline the method as step titles, from prep to plating."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下ごしらえから盛り付けまで、作り方を手順の題名で並べてください。"
          }
        }
      }
    },
    "Generate.Prompt.Pick": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are choosing the shopping list and nothing else. Name the dish, then list the ingredients it is cooked from, one name per entry, with no amounts and no prep work. Pick ingredients that cook together in the same pan over the same half hour, and leave out anything the dish can do without.\n\nThe app draws each ingredient from a fixed catalog of icons. Call checkIngredient for every ingredient before you list it, and take the swap it suggests when the catalog has nothing for it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで決めるのは材料だけです。料理名を挙げてから、その料理に使う材料を一つずつ、分量も下ごしらえも書かずに並べてください。同じフライパンで同じ30分のあいだに火が通る材料を選び、なくても成り立つものは省きます。\n\nアプリは決まったアイコンの一覧から材料の絵を出します。材料を挙げる前に必ず checkIngredient を呼び、一覧にないと返ってきたら勧められた材料に置き換えてください。"
          }
        }
      }
    },
    "Generate.Prompt.Pick.Kitchen": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The cook has told you everything they have in the kitchen. Ask for nothing else. Every ingredient you pick has to come from their list, and it is fine to leave some of the list unused. If the list cannot make the dish they named, pick the ingredients for the closest dish it can make."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作る人はキッチンにあるものをすべて伝えています。それ以外は求めないでください。選ぶ材料はすべてその一覧から取り、使わないものが残ってもかまいません。その一覧では挙げられた料理が作れないときは、いちばん近い作れる料理の材料を選びます。"
          }
        }
      }
    },
    "Generate.Prompt.Pick.NoDish": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "They have not named a dish, so pick one their ingredients make well."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料理名は伝えられていないので、手元の材料でうまく作れる料理を選んでください。"
          }
        }
      }
    },
    "Generate.Prompt.Separator": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": ", "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        }
      }
    },
    "Generate.Prompt.Step": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are writing one step of a method that is already planned. Cover that step only, and do not repeat what earlier or later steps do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに決まっている作り方のうち、一つの手順だけを書きます。その手順のことだけを書き、前後の手順の中身は繰り返さないでください。"
          }
        }
      }
    },
    "Generate.Prompt.Step.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Write step %1$@, \"%2$@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順%1$@「%2$@」を書いてください。"
          }
        }
      }
    },
    "Generate.Prompt.Troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are writing the troubleshooting notes. Each problem is a short symptom with no closing period, written in the third person such as \"The rice turned mushy\", or as a want without the pronoun such as \"Want it more filling\". Each solution is one to three full sentences."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで書くのは困ったときの覚え書きです。困りごとは「ご飯がべちゃっとした」のような短い一文で、句点は付けません。「もっと食べ応えがほしい」のような望みの形でもかまいません。直し方は一文から三文で書きます。"
          }
        }
      }
    },
    "Generate.Prompt.Troubleshooting.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What goes wrong when someone cooks this, and how do they fix it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この料理を作るときによくある失敗と、その直し方を書いてください。"
          }
        }
      }
    },
    "Generate.Title": {
      "extractionState": "manual",
