    "Edit.Ask.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what you want to change. Review the proposed edits before they are applied."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更したい内容を入力してください。変更を適用する前に、変更案を確認できます。"
