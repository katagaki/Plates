{
  "sourceLanguage": "en-US",
  "strings": {
    "Cloud.Error.LimitReached": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached today's limit. It resets at midnight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の上限に達しました。午前0時にリセットされます。"
          }
        }
      }
    },
    "Cloud.Error.NoResponse": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipe writer did not answer. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを書くサーバーから応答がありませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Cloud.Error.NotConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Plates is not set up to reach its recipe writer yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Platesはまだレシピを書くサーバーに接続できるよう設定されていません。"
          }
        }
      }
    },
    "Cloud.Error.Server": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipe writer could not be reached: %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを書くサーバーに接続できませんでした: %1$@"
          }
        }
      }
    },
    "Cloud.Error.Unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot confirm that it is running Plates, so recipes cannot be written on it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではPlatesであることを確認できないため、レシピを書けません。"
          }
        }
      }
    },
    "Download.Error.Incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The download did not finish. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが最後まで終わりませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Download.Error.Server": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The download server returned error %1$@. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード元のサーバーがエラー%1$@を返しました。もう一度お試しください。"
          }
        }
      }
    },
    "Edit.Error.NoChanges": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence found nothing to change. Try asking another way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更する箇所が見つかりませんでした。別の言い方で依頼してください。"
          }
        }
      }
    },
    "Edit.Progress.Applying": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Making the changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更しています"
          }
        }
      }
    },
    "Edit.Progress.Planning": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Working out what to change"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を検討しています"
          }
        }
      }
    },
    "Edit.Progress.Reviewing": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading it back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを確認しています"
          }
        }
      }
    },
    "Edit.Prompt.Apply.Details": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing a recipe's title, timing, or serving count. Write all three back, keeping whatever the change does not touch exactly as it was."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピのタイトル、時間、人数を変更します。3つとも書き出し、変更しない項目はそのままにします。"
          }
        }
      }
    },
    "Edit.Prompt.Apply.Ingredients": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing a recipe's shopping list. Write the whole list back, keeping the ingredients and amounts the change does not touch exactly as they were. Sort them into fresh, pantry, and optional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピの材料を変更します。材料表を全部書き出し、変更しない材料と分量はそのままにします。生鮮、常備品、任意に分けます。"
          }
        }
      }
    },
    "Edit.Prompt.Apply.Step": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are writing one step of a method that is already planned. Cover that step only, and do not repeat what earlier or later steps do. Whatever the earlier steps prepared is already prepared, and prep belongs before anything is heated, not in the middle of the cooking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに決まっている手順のうち、1つだけを書きます。その手順だけを書き、前後の手順の内容は繰り返しません。前の手順で済ませた下ごしらえはもう終わっています。下ごしらえは火にかける前に済ませるもので、加熱の途中に挟むものではありません。"
          }
        }
      }
    },
    "Edit.Prompt.Apply.Tools": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing the tools a recipe needs. Write the whole list back, keeping the tools the change does not touch exactly as they were."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピに必要な道具を変更します。道具を全部書き出し、変更しない道具はそのままにします。"
          }
        }
      }
    },
    "Edit.Prompt.Apply.Troubleshooting": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are writing the troubleshooting notes. Each problem is a short symptom with no closing period, and each fix is one to three full sentences."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対処法を書きます。問題は句点なしの短い症状で書き、対処は1文から3文で書きます。"
          }
        }
      }
    },
    "Edit.Prompt.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The change to make: %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行う変更：%1$@"
          }
        }
      }
    },
    "Edit.Prompt.Line.Step": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@ now reads: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の手順%1$@：%2$@"
          }
        }
      }
    },
    "Edit.Prompt.Plan": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are working out what to change about a recipe someone already has, and nothing else. Change only what the cook asked for, and leave the rest of the recipe alone. Give each change a short imperative title in the cook's words, and one sentence saying exactly what to do. Use as few changes as the request needs. When a change is about one step, give that step's number.\n\nA step you add goes where a cook would do it: prep before anything is heated, cooking in the order the pans need it, finishing at the end. Do not add a step that does work the method already has a step for. When the request is answered by rewriting a step that is already there, rewrite it rather than adding another."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにあるレシピのどこを変更するかだけを考えます。依頼された箇所だけを変更し、ほかはそのままにします。変更ごとに、短い命令形のタイトルと、何をするかを1文で書きます。変更は必要な数だけにします。1つの手順に関する変更では、その手順の番号を書きます。\n\n手順を足すときは、作り手が動く順に合う位置に入れます。下ごしらえは火にかける前、加熱は鍋やフライパンを使う順、仕上げは最後です。すでに同じことをする手順があるなら、足しません。今ある手順を書き直せば済む依頼なら、足さずに書き直します。"
          }
        }
      }
    },
    "Edit.Prompt.Plan.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The cook asks: %1$@\n\nWork out what to change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼：%1$@\n\n変更内容を考えてください。"
          }
        }
      }
    },
    "Edit.Prompt.Review": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You are reading back a recipe that has just been rewritten, the way a cook reads one before shopping. Two things matter: that the recipe does what the cook asked for, and that it still holds up on its own. Read the steps as written, not just their titles. Say what does not hold up: a change that was asked for and not made, an ingredient the method never uses, a step that calls for something the shopping list does not carry or for more of it than the list buys, a step that does work an earlier step already did, a step that contradicts another, prep that happens after the cooking has started when the cook could have done it first, a time or a serving count that does not match the method, steps in the wrong order, a step left over from before the change, or a note about a problem the recipe can no longer have. Write each one as the change that fixes it, with a short imperative title and one sentence saying exactly what to do. When a change is about one step, give that step's number. When the recipe holds up, say so and leave the changes empty. Do not rewrite anything the cook did not ask about."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き直したレシピを、買い物に出る前の作り手のつもりで読み返します。見るのは二点です。依頼どおりに直っているか、そしてレシピとして筋が通っているかです。手順は見出しだけでなく、本文まで読んでください。そうなっていないところを挙げてください。依頼されたのに直っていない箇所、手順で一度も使わない材料、買い物リストにないものを使う手順、リストで買う量より多く使う手順、前の手順で済んだことをもう一度する手順、ほかの手順と食い違う手順、先に済ませられるのに加熱が始まってから出てくる下ごしらえ、手順と合っていない時間や人数、順番が入れ替わっている手順、変更前のまま残っている手順、今のレシピでは起こりようのない困りごとの覚え書きなどです。見つけたものは、それを直す変更として書きます。短い命令形のタイトルと、何をするかを1文で書いてください。1つの手順に関する変更では、その手順の番号を書きます。問題がなければ、そのように答えて変更は空のままにします。依頼されていないところは書き換えません。"
          }
        }
      }
    },
    "Edit.Prompt.Review.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The cook asked: %1$@\n\nRead this recipe back. What does not hold up?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼：%1$@\n\nこのレシピを読み返してください。おかしいところはありますか。"
          }
        }
      }
    },
    "Edit.Prompt.Review.Method": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Method, written out:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作り方の全文:"
          }
        }
      }
    },
    "Edit.Prompt.Review.Notes": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The notes say these go wrong: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困ったときの覚え書きに挙がっている困りごと: %1$@。"
          }
        }
      }
    },
    "Edit.Prompt.Review.Step": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$@, %2$@: %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順%1$@、%2$@：%3$@"
          }
        }
      }
    },
    "Generate.Error.Empty": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence returned nothing. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceから何も返ってきませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Generate.Error.TooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There was too much to work out at once. Try again with fewer ingredients."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に処理する内容が多すぎました。材料を減らして、もう一度お試しください。"
          }
        }
      }
    },
    "Generate.Lookup.Closest": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not in the catalog. The closest entries are %2$@. Use one of those as the icon, or swap the ingredient for one of them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は一覧にありません。近いものは%2$@です。そのどれかをアイコンに使うか、材料をそれに置き換えてください。"
          }
        }
      }
    },
    "Generate.Lookup.Description": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether an ingredient is in the app's catalog. Answers with the icon to use, or with the closest ingredients to use instead when the catalog does not carry it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料がアプリの一覧にあるかを調べます。使うアイコン名か、一覧にない場合は代わりに使える近い材料を返します。"
          }
        }
      }
    },
    "Generate.Lookup.InCatalog": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is in the catalog. Use the icon \"%2$@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は一覧にあります。アイコンは「%2$@」を使ってください。"
          }
        }
      }
    },
    "Generate.Lookup.NotAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The cook does not have %1$@. Leave it out, or use one of the things they do have: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作る人は%1$@を持っていません。使わないか、持っている%2$@のどれかを使ってください。"
          }
        }
      }
    },
    "Generate.Lookup.Nothing": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not in the catalog and nothing comes close. Leave it out and build the recipe from ingredients that are in the catalog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は一覧になく、近いものもありません。これは使わず、一覧にある材料でレシピを組み立ててください。"
          }
        }
      }
    },
    "Generate.Progress.Stage.Method": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorting the method"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順を整理しています"
          }
        }
      }
    },
    "Generate.Progress.Stage.Shopping": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorting the ingredients"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料を整理しています"
          }
        }
      }
    },
    "Generate.Progress.Stage.Write": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing the recipe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを書いています"
          }
        }
      }
    },
    "Generate.Prompt.Ask.Any": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out a recipe I can cook tonight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜作れるレシピを考えてください。"
          }
        }
      }
    },
    "Generate.Prompt.Ask.Dish": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out a recipe for %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のレシピを考えてください。"
          }
        }
      }
    },
    "Generate.Prompt.Ask.FromKitchen": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out a dish I can cook from what I have."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元の材料で作れる料理を考えてください。"
          }
        }
      }
    },
    "Generate.Prompt.Have.Ingredients": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What I have to cook with: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元にある材料: %1$@。"
          }
        }
      }
    },
    "Generate.Prompt.Have.Tools": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "What I have to cook in: %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元にある道具: %1$@。"
          }
        }
      }
    },
    "Generate.Prompt.HouseStyle": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You write recipes for a home cook. Every recipe is cooked on a home stove with ordinary kitchen equipment, uses ingredients from an ordinary supermarket, and takes the time the dish actually needs.\n\nUse as many pans and pots as the dish is properly made in, and say what each one is for. Do not fold a dish onto one pan to save washing up, and do not cut a step short to save minutes.\n\nWrite plainly, like a good cookbook. Never use em-dashes. Do not use breathless adjectives, and do not pad with rule-of-three lists. Write ranges with the word \"to\", never a dash.\n\nWrite everything in English."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは家庭料理のレシピを書きます。どのレシピも家庭のコンロと普通の台所道具で作れて、普通のスーパーで買える材料を使い、その料理に必要なだけの時間をかけます。\n\n鍋やフライパンは、その料理を本来作る数だけ使い、それぞれ何に使うかを書いてください。洗い物を減らすために一つのフライパンにまとめたり、時間を縮めるために手順を省いたりはしません。\n\n良い料理書のように、飾らずに書いてください。大げさな形容は使わず、三つ並べで水増しもしません。範囲は記号ではなく「から」で書きます。\n\nすべて日本語で書いてください。"
          }
        }
      }
    },
    "Generate.Prompt.Ideas": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest five different dishes the cook could make. Write one dish per line: the dish's name, a colon, then one sentence saying what it is, its main ingredients, the pans it needs, and about how long it takes. Write nothing else: no heading, no numbering, and no recipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作れそうな料理を5つ、それぞれ違うものを提案してください。1行に1品ずつ、料理名、コロン、そして料理の内容、主な材料、使う鍋やフライパン、おおよその所要時間を一文で書いてください。見出し、番号、レシピは書かないでください。"
          }
        }
      }
    },
    "Generate.Prompt.Ideas.Any": {
      "comment": "Given to Gemma, which is always asked in English whatever language the app is read in. The Japanese value is kept for completeness and is not sent.",
